<Window x:Class="GameFlowStudio.Desktop.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用帮助"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="HelpTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="0,0,0,10"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="PageIntroStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="HelpCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,8,12"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="BulletTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style x:Key="NoticeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <StackPanel>
                <TextBlock Text="GameFlow Studio 使用帮助"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="按主题查看操作步骤与模式说明；各页内容彼此独立，方便快速查找。"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Style="{StaticResource HelpTabControlStyle}"
                    Margin="18,16,18,12">
            <TabItem Header="快速开始">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="快速开始"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="第一次使用时，按下面的顺序即可完成一个可运行的自动化流程。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="1. 建立项目"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 在“项目文件”面板点击“+”新建项目，或点击文件夹按钮打开已有的 .gflow 项目。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 新项目会自动创建“主流程”，并在画布放入已经连接的“开始”和“结束”节点。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="2. 添加并连接步骤"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 点击下方“操作卡片”中的按钮，把操作节点添加到当前画布。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 将节点按“开始 → 操作或判断 → 结束”的顺序连接。判断节点需要分别连接“是”和“否”分支。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 选中节点后，在右侧“属性”面板填写按键、坐标、窗口标题、等待时间等参数。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="3. 保存并试运行"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 点击项目面板顶部的保存按钮；首次保存需要选择 .gflow 文件位置。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 点击“调试运行”可留在编辑器中观察节点高亮和日志；确认无误后，可使用“运行”进入轻量运行窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 自动化会真实操作鼠标、键盘和窗口，运行前请保存其他软件中的重要内容。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}" BorderBrush="{DynamicResource WarningBorderBrush}">
                            <TextBlock Style="{StaticResource NoticeTextStyle}"
                                       Text="提示：软件当前没有自动保存。新建、打开、关闭或粘贴项目前，请先保存需要保留的修改。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="项目与脚本">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="项目与脚本"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="一个 .gflow 项目可以包含多个脚本；软件一次只编辑一个项目。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="项目文件"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 项目面板顶部依次是新建、打开、保存、另存为。当前项目卡片不是历史列表，单击它会打开项目选择窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 首次“保存”会要求选择路径；之后“保存”写回原文件，“另存为”始终选择新路径。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 保存时会收集当前画布的最新内容，并把项目中的全部脚本一起写入文件。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="脚本管理"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 左键单击脚本卡片进行切换；点击脚本列表右侧“+”创建新脚本。项目至少保留一个脚本。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 右键脚本可打开“复制、属性、删除”。脚本名称会在当前项目内自动保持唯一。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• “属性”可设置脚本名称、选择作用域、执行方式、操作流程和默认节点等待时间。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 默认节点等待时间是普通节点之间的统一间隔；“等待”节点仍使用自己的等待时长。设为 0 可关闭默认间隔。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="复制与粘贴"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 右键项目或脚本卡片选择“复制”，再在对应面板的空白处右键选择“粘贴”。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 粘贴项目会载入一个未保存的完整副本，不会在面板中增加第二个并列项目；粘贴脚本会追加新脚本并立即切换过去。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 脚本若包含指向其他脚本的跳转，不能直接粘贴到另一个项目；请复制整个项目，或先移除跨脚本跳转。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 项目、脚本和画布节点使用各自独立的软件内剪贴板，关闭软件后复制内容会失效。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}" BorderBrush="{DynamicResource WarningBorderBrush}">
                            <TextBlock Style="{StaticResource NoticeTextStyle}"
                                       Text="删除脚本目前没有单独的确认或撤销步骤。删除前建议先保存项目，或先复制需要保留的脚本。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="画布与节点">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="画布与节点"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="画布负责流程顺序，属性面板负责每个节点的具体参数。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="节点分类"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 逻辑类：色判断、图判断、文本判断、跳转。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 基础类：开始、结束、等待。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 键盘类：键盘按键、输入文本。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 鼠标类：点击、鼠标拖动、鼠标滑动。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 窗口与程序类：启动程序、关闭程序、最小化窗口、窗口整理、设置窗口分辨率。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="编辑流程"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 点击操作卡片会在画布添加节点；选中节点后，在右侧修改显示名称和操作参数。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 节点右键菜单提供复制、删除和属性；画布空白处右键可粘贴节点。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 判断节点输出“是 / 否”两条分支。流程不允许形成循环，跳转节点用于跳到指定脚本或指定节点。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 左下角“整理”会紧凑排列节点并聚焦完整流程，适合在节点较多或画布散乱时使用。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="窗口操作节点"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 窗口整理使用卡片标题正则处理整组窗口；后台关闭、最小化和分辨率在有唯一脚本窗口上下文时只处理当前窗口，否则才按卡片标题正则处理匹配窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 关闭、最小化和设置分辨率跟随脚本的执行方式；后台方式不激活匹配窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• “窗口整理”本身不会激活窗口：把第一个窗口放到设置的 x、y，后续匹配窗口按垂直偏移量依次排列。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 节点自己的窗口正则只能在脚本匹配结果内进一步限定；已有唯一窗口轨道时不能改到其他窗口，也不能重新加入被脚本排除的目标。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="操作录制">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="操作录制"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="录制会把步骤直接追加到当前脚本，不会创建新脚本，也不会自动保存到磁盘。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="录制步骤"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="1. 先切换到需要追加操作的脚本。脚本应有一个带输入连接的“结束”节点；如果有多个结束节点，先选中目标结束节点。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="2. 点击当前脚本卡片右侧的“录制”，选择“基于屏幕”或“基于窗口”。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="3. 窗口模式需要从列表选择目标应用；随后在目标应用中执行点击、拖动、滚轮和键盘操作。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="4. 按 F7 或点击“停止”结束。录制步骤会插到目标结束节点之前，并加入“录制开始 / 录制结束”标记。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="5. 录制生成的点击、拖动、滚轮和按键跟随当前脚本的执行方式。检查节点和连线后手动保存项目。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="基于屏幕"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 记录虚拟桌面中的操作，鼠标坐标保存为绝对物理像素坐标。多显示器左侧或上方的屏幕可能产生负坐标。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• GameFlow Studio 自身窗口中的普通操作会被过滤，不写入录制结果。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 适合跨多个程序或不需要绑定某个窗口的流程。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="基于窗口"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 只记录所选窗口及其所属弹出窗口中的操作；键盘输入仅在目标窗口处于前台时记录。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 鼠标坐标保存为相对于窗口外框左上角的位置；从窗口内开始的拖动即使中途移出，也保留为同一次拖动。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 录制片段会加入窗口定位信息，回放时按录制时的完整窗口标题查找目标窗口；前台操作执行时再激活该窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 窗口标题变化或存在多个同名窗口时，可能找不到原窗口或匹配到另一个窗口，请检查“录制开始”节点参数。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}" BorderBrush="{DynamicResource WarningBorderBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource WarningForegroundBrush}" Text="录制限制"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 当前不记录连续鼠标移动轨迹、触摸、手柄、IME 文本提交、Windows 键组合和 Alt+Tab。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 锁屏、UAC 安全桌面及部分受保护游戏输入可能无法捕获；录制达到 4,000 个操作时会自动停止。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 未捕获到有效操作时，当前脚本不会发生变化。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="坐标与检测">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="坐标与检测"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="“拾取方式”“坐标基准”和“脚本匹配模式”是三个不同概念，请分别设置。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="坐标拾取方式"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 基于屏幕：拾取虚拟桌面的绝对物理像素坐标，并把节点坐标基准设为“强制绝对”。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 基于窗口：先选择可见窗口，再拾取相对窗口外框左上角的坐标，并把节点设为“强制相对”。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 基于窗口拾取只负责填写相对坐标，不会把所选窗口保存为脚本目标。运行前仍需建立唯一窗口上下文。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 色判断拾取一个点并读取颜色；图判断拖框截取模板；文本判断拖框填写识别区域。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="节点坐标基准"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 跟随脚本：有唯一目标窗口时使用窗口相对坐标；没有目标窗口时使用屏幕绝对坐标。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 强制绝对：始终按虚拟桌面绝对坐标执行，即使脚本设置了目标窗口也不叠加窗口位置。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 强制相对：始终叠加到当前目标窗口左上角，运行时必须恰好有一个目标窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 目标窗口移动后，相对坐标会使用窗口运行时的最新位置。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}" BorderBrush="{DynamicResource WarningBorderBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Foreground="{DynamicResource WarningForegroundBrush}" Text="前台与后台模式"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 在脚本属性中统一选择前台或后台；脚本内的操作卡片不再单独设置。不同执行方式提供不同的操作流程。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 前台输入会激活目标窗口并发送真实系统输入；前台读取会激活窗口后读取桌面上的可见像素。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 前台模式可选择“伪并行”或“串行”。伪并行依次切换窗口执行当前操作，使各窗口的进度尽量一致；串行会完整执行一个窗口后再处理下一个。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 后台方式下，点击、移动、拖动、滚轮、按键和文本输入不移动真实鼠标或激活窗口，而是向唯一目标窗口或焦点控件投递传统 Win32 消息。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 后台方式下，色判断、图判断和文本判断不激活窗口，通过 PrintWindow 请求唯一目标窗口自行绘制，再从结果中读取指定区域。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 后台模式固定使用“并行”：脚本匹配模式筛选出多个窗口时，每个窗口同时运行一套独立流程；单套流程内的后台输入和读取仍只面向自己的唯一目标窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 后台输入和后台读取必须有目标窗口；选择整个屏幕且没有建立窗口上下文时不能使用。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 游戏、Raw Input、DirectInput、高权限或受保护程序可能忽略后台输入；硬件加速、受保护或最小化窗口可能拒绝后台绘制或返回黑图。后台读取单次最多等待 5 秒；消息投递成功不代表业务操作成功。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 后台鼠标只支持客户区坐标，不用于标题栏、边框或窗口外部；单个后台点击节点最多点击 100 次。后台关闭、最小化和分辨率操作有唯一脚本窗口上下文时只处理当前窗口；没有唯一上下文时才按卡片标题正则处理匹配窗口。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="图判断与文本判断的范围"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 固定坐标：使用节点保存的 x、y、width、height，且这些值继续受节点坐标基准控制。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 当前屏幕 / 窗口：忽略节点保存的固定区域；没有窗口时检查整个虚拟桌面，有唯一窗口时检查完整窗口区域。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 存在多个尚未拆分的目标窗口时，无法确定“当前屏幕 / 窗口”的唯一范围。色判断始终使用固定区域。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="图像匹配模式"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 自实现：逐像素比较 RGB，各通道在“容差”内的像素计为匹配，再与匹配阈值比较。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• OpenCV：使用归一化模板匹配计算相似度，主要调节匹配阈值；当前实现不使用逐像素“容差”。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 分数达到匹配阈值才算命中。降低阈值会更宽松，但也会增加误判。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="文本识别模式"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• Gemini OCR：把截图发送给 Gemini 服务识别，需要联网，并在“设置”填写 API 密钥或配置 GEMINI_API_KEY 环境变量。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 本地 OCR（占位）：当前尚未接入实际识别引擎，选择后会提示未实现，暂不能用于正式流程。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="操作流程">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="选择作用域与操作流程"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="在脚本卡片上右键打开“属性”，可设置整个脚本的选择作用域、执行方式和操作流程。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="整个屏幕"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 不按标题寻找窗口，也不自动建立目标窗口；脚本只执行一次。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• “跟随脚本”坐标按屏幕绝对坐标处理；没有多个目标窗口时，操作流程不会产生多窗口调度效果。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 这里的“整个屏幕”表示不限制目标窗口，不代表每个检测节点都会自动扫描全屏。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="正则匹配窗口"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 先使用“正则匹配”从可见、有标题的顶级窗口中规定要操作的窗口，标题匹配不区分大小写。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 再使用“排除正则匹配”从正则匹配结果中移除不需要的窗口；留空表示不排除。排除规则不会扩大最初的匹配结果。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 正则匹配没有找到窗口，或者匹配结果全部被排除时运行失败。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 筛选出多个窗口时，按脚本属性中的“操作流程”运行。前台可选伪并行或串行，后台固定并行；前台输入和读取会激活当前窗口，后台方式不会激活。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 跨脚本跳转会继承当前轨道；两个脚本的前后台方式、操作流程、匹配模式开关以及包含与排除规则都须一致，且当前窗口仍须通过目标脚本的包含与排除筛选。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="串行（前台）"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}"
                                           Text="每个窗口完整执行完操作，再进行下一个窗口。适合每个窗口都需要连续完成一整套操作的场景。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="伪并行（前台）"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 每个窗口依次切换进行操作，实现操作进度一致；开始、等待、判断和结束也计入轮次。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 每个窗口保存独立的执行进度和变量，可以走不同的判断分支，并在不同时间结束。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 它会依次激活各窗口，并不是真正同时操作；窗口或节点较多时，频繁切换会比串行更慢。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="并行（后台）"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 每个窗口同时进行操作，各窗口拥有独立的执行进度、变量和判断分支。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 并行流程不会为了调度而依次激活窗口，整体完成时间取决于最晚结束的窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 启动程序和窗口整理属于全局动作，同一轮由所有窗口流程共享一次执行，不会按窗口重复启动或整理。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 后台输入和读取仍受目标程序支持程度影响；消息投递成功不代表程序一定响应。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="运行与界面">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="运行与界面"/>
                        <TextBlock Style="{StaticResource PageIntroStyle}"
                                   Text="“调试运行”用于编辑阶段排查流程，“运行”用于日常执行。"/>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="调试运行"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 在编辑器内运行当前脚本，画布会显示当前节点高亮，顶部显示状态，日志显示执行过程、耗时和错误。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 运行期间画布只读，可使用顶部“暂停、继续、停止”；结束后恢复编辑。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="运行"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 先验证并保存项目的最新内容，然后关闭编辑器并启动置顶的轻量运行窗口。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 在停止状态可选择脚本；运行窗口提供开始、暂停、继续、停止，并可切回编辑器。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 两种执行方式使用相同的工作流执行逻辑，窗口、坐标和检测模式的行为一致。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="顶部界面按钮"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• “项目、脚本、操作卡片、属性、日志”用于显示或隐藏对应面板。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 面板之间的分隔条可以拖动，调整项目列表、脚本列表、属性和日志所占空间。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 录制或运行期间，与项目和脚本有关的编辑操作会暂时禁用，结束后自动恢复。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HelpCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="全局设置"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 默认项目目录：新建、打开和保存项目时优先使用的文件夹。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• Gemini OCR API 密钥：供文本判断的 Gemini OCR 模式使用。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 启动可见模块：决定软件下次启动时默认显示哪些面板。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 操作卡片“竖向 / 横向”：只改变下方分类的排列方式，不改变画布流程方向，也不等于整理画布。"/>
                                <TextBlock Style="{StaticResource BulletTextStyle}" Text="• 软件采用 Windows 10 浅色风格，面板可通过顶部按钮调整显示。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="关闭"
                        Width="88"
                        IsDefault="True"
                        IsCancel="True"
                        Click="CloseClick"/>
                <TextBlock Text="帮助内容按功能分组，可直接切换上方页签查找。"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSubtleBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
