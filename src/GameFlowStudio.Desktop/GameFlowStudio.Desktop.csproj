<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\GameFlowStudio.Contracts\GameFlowStudio.Contracts.csproj" />
    <ProjectReference Include="..\GameFlowStudio.Storage\GameFlowStudio.Storage.csproj" />
    <ProjectReference Include="..\GameFlowStudio.Protocol\GameFlowStudio.Protocol.csproj" />
    <ProjectReference Include="..\..\core\GameFlowStudio.Runtime\GameFlowStudio.Runtime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameFlowStudio.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\GameFlowStudio.Editor\dist\**\*"
             Link="EditorAssets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('..\GameFlowStudio.Editor\dist\index.html')" />
    <Content Include="EditorAssets\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Condition="!Exists('..\GameFlowStudio.Editor\dist\index.html')" />
    <Content Include="..\..\samples\basic-example.gflow" Link="samples\basic-example.gflow" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyRuntimeWorkerToDesktopOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <RuntimeWorkerOutput Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildThisFileDirectory)..\..\core\GameFlowStudio.Runtime\bin\$(Configuration)\net10.0-windows\</RuntimeWorkerOutput>
      <RuntimeWorkerOutput Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildThisFileDirectory)..\..\core\GameFlowStudio.Runtime\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\</RuntimeWorkerOutput>
    </PropertyGroup>
    <ItemGroup>
      <RuntimeWorkerFiles Include="$(RuntimeWorkerOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerFiles)" DestinationFiles="@(RuntimeWorkerFiles->'$(TargetDir)Runtime\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishRuntimeWorker" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <RuntimeWorkerPublishDir>$(MSBuildThisFileDirectory)obj\runtime-publish\$(Configuration)\$(RuntimeIdentifier)\</RuntimeWorkerPublishDir>
      <RuntimeWorkerProject>$(MSBuildThisFileDirectory)..\..\core\GameFlowStudio.Runtime\GameFlowStudio.Runtime.csproj</RuntimeWorkerProject>
    </PropertyGroup>
    <MSBuild Projects="$(RuntimeWorkerProject)" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishDir=$(RuntimeWorkerPublishDir)" />
    <ItemGroup>
      <RuntimeWorkerPublishFiles Include="$(RuntimeWorkerPublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeWorkerPublishFiles)" DestinationFiles="@(RuntimeWorkerPublishFiles->'$(PublishDir)Runtime\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateEditorAssetsForPublish" BeforeTargets="Publish">
    <Error Condition="!Exists('EditorAssets\index.html') and !Exists('..\GameFlowStudio.Editor\dist\index.html')"
           Text="Editor assets are missing. Run npm ci and npm run build in src/GameFlowStudio.Editor before publishing Desktop." />
  </Target>
</Project>
