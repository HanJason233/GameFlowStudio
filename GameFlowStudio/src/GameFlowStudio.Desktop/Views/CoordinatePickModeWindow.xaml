<Window x:Class="GameFlowStudio.Desktop.Views.CoordinatePickModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameFlowStudio.Desktop.Controls"
        Title="选择拾取模式" Width="390" Height="220" MinWidth="350" MinHeight="190"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#111827" Foreground="#E2E8F0">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <controls:SelectableTextBlock Text="选择坐标拾取模式" FontSize="16" FontWeight="SemiBold"/>
            <controls:SelectableTextBlock Text="屏幕模式直接记录屏幕坐标；窗口模式会先选择窗口，再换算为窗口内坐标。"
                                          Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,18,0,12">
            <Button Content="基于屏幕" Click="ScreenClick" Margin="0,0,6,0" Padding="8,7"/>
            <Button Content="基于窗口" Click="WindowClick" Margin="6,0,0,0" Padding="8,7" Background="#2563EB" BorderBrush="#3B82F6"/>
        </UniformGrid>

        <Button Grid.Row="2" Content="取消" Click="CancelClick" HorizontalAlignment="Right" Padding="16,5"/>
    </Grid>
</Window>
