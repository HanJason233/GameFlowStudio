<Window x:Class="GameFlowStudio.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameFlowStudio.Desktop.Controls"
        Title="全局设置" Width="520" Height="500" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#111827" Foreground="#E2E8F0">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="软件全局设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,8">
                    <StackPanel>
                        <controls:SelectableTextBlock Text="默认项目目录"/>
                        <TextBox Text="{Binding DefaultProjectDirectory, UpdateSourceTrigger=PropertyChanged}"/>

                        <controls:SelectableTextBlock Text="原子动作分类布局" Margin="0,16,0,0"/>
                        <ComboBox SelectedValue="{Binding StepCategoryLayout}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="vertical" Content="竖向（分类上下排列）"/>
                            <ComboBoxItem Tag="horizontal" Content="横向（分类左右排列）"/>
                        </ComboBox>
                        <controls:SelectableTextBlock Text="设置对所有项目生效；原子动作模块位于节点编辑区下方，可拖动分隔线调整高度。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="3,5,3,0"/>

                        <controls:SelectableTextBlock Text="主题" Margin="0,16,0,0"/>
                        <ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Content">
                            <ComboBoxItem Content="light"/>
                            <ComboBoxItem Content="dark"/>
                        </ComboBox>
                        <controls:SelectableTextBlock Text="主题背景会立即应用；编辑器画布保持深色。" Foreground="#94A3B8" TextWrapping="Wrap" Margin="3,5,3,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="快捷键">
                <StackPanel Margin="8,12">
                    <controls:SelectableTextBlock Text="运行快捷键（F1-F24）"/>
                    <TextBox Text="{Binding RunHotkey, UpdateSourceTrigger=PropertyChanged}"/>
                    <controls:SelectableTextBlock Text="暂停/继续快捷键" Margin="0,12,0,0"/>
                    <TextBox Text="{Binding PauseHotkey, UpdateSourceTrigger=PropertyChanged}"/>
                    <controls:SelectableTextBlock Text="停止快捷键" Margin="0,12,0,0"/>
                    <TextBox Text="{Binding StopHotkey, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Click="CancelClick"/>
            <Button Content="保存" Click="SaveClick" Background="#1D4ED8"/>
        </StackPanel>
    </Grid>
</Window>
