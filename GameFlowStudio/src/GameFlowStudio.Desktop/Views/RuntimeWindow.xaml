<Window x:Class="GameFlowStudio.Desktop.Views.RuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameFlowStudio.Desktop.Controls"
        Title="GameFlow 纯运行" Width="340" Height="470" MinWidth="300" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Border Background="#111827" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBarMouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GameFlow" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                    <TextBlock Text=" · 纯运行" Foreground="#60A5FA" FontSize="13" VerticalAlignment="Center" Margin="4,2,0,0"/>
                </StackPanel>
                <Button Content="×" Click="CloseClick" HorizontalAlignment="Right" Width="28" Height="26" Padding="0" Margin="0" Background="Transparent" BorderBrush="Transparent" FontSize="18"/>
            </Grid>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="{Binding ProjectName}" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" Foreground="#93C5FD" FontSize="12"/>
            </DockPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                     IsEnabled="{Binding IsSelectionEnabled}" Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#64748B" Margin="12,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Height="8" VerticalAlignment="Center" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Foreground="#3B82F6" Background="#263756"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#94A3B8" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <DockPanel Grid.Row="4" Margin="0,9,0,0">
                <TextBlock Text="当前节点" Foreground="#64748B"/>
                <TextBlock Text="{Binding CurrentNodeText}" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
            </DockPanel>

            <TextBlock Grid.Row="5" Text="{Binding ErrorText}" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Grid Grid.Row="6" VerticalAlignment="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Content="{Binding RunSwitchText}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              Command="{Binding ToggleRuntimeCommand}" HorizontalContentAlignment="Center" Background="#1D4ED8" BorderBrush="#3B82F6"/>
                <Button Grid.Column="1" Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPauseResume}" Width="66"/>
                <Button Grid.Column="2" Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsWorkflowActive}" Width="54"/>
            </Grid>
        </Grid>
    </Border>
</Window>
