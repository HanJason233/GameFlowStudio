<Window x:Class="GameFlowStudio.Desktop.Views.RuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行" Width="360" Height="420" MinWidth="300" MinHeight="340"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"/>
                <Button Content="编辑器" Click="SwitchToEditorClick" Width="68" Margin="5,0,0,0" DockPanel.Dock="Right"/>
            </DockPanel>

            <ListBox Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                     IsEnabled="{Binding IsSelectionEnabled}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="12,0,2,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Height="8" VerticalAlignment="Center" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="节点"/>
                <TextBlock Text="{Binding CurrentNodeText}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
            </DockPanel>

            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="窗口"/>
                <TextBlock Grid.Column="1" Text="{Binding CurrentWindowTitle}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding CurrentWindowHandleText}" Margin="8,0,0,0"/>
            </Grid>

            <TextBlock Grid.Row="5" Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <Grid Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding RunSwitchText}" Command="{Binding ToggleRuntimeCommand}" Width="84"/>
                <Button Grid.Column="1" Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsWorkflowActive}" Width="84" Margin="6,0,0,0"/>
            </Grid>
    </Grid>
</Window>
