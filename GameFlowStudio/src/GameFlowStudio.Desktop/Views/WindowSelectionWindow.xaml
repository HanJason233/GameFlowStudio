<Window x:Class="GameFlowStudio.Desktop.Views.WindowSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GameFlowStudio.Desktop.Controls"
        Title="选择目标窗口" Width="620" Height="430" MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="#111827" Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="刷新" Click="RefreshClick" DockPanel.Dock="Right"/>
            <StackPanel>
                <controls:SelectableTextBlock Text="选择用于捕获相对坐标的窗口" FontSize="16" FontWeight="SemiBold"/>
                <controls:SelectableTextBlock Text="请选择目标窗口，然后在屏幕上点击要捕获的位置。" Foreground="#94A3B8" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <ListBox x:Name="WindowList" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" MouseDoubleClick="WindowDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:SelectableTextBlock Text="{Binding Path=Title, Mode=OneWay}" FontSize="13"/>
                        <controls:SelectableTextBlock Grid.Column="1" Text="{Binding Path=Handle, Mode=OneWay}" Foreground="#64748B" Margin="16,0,4,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Click="CancelClick"/>
            <Button Content="选择" Click="SelectClick" Background="#2563EB" BorderBrush="#3B82F6"/>
        </StackPanel>
    </Grid>
</Window>
