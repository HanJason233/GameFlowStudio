<Window x:Class="GameFlowStudio.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:GameFlowStudio.Desktop.Converters"
        xmlns:controls="clr-namespace:GameFlowStudio.Desktop.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GameFlow Studio" Width="1400" Height="900" MinWidth="1200" MinHeight="650"
        Background="{StaticResource AppBackground}" Foreground="#E2E8F0"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility"/>
        <converters:StringPercentConverter x:Key="StringPercent"/>
        <converters:PercentTextConverter x:Key="PercentText"/>
        <DataTemplate x:Key="StepCategoryTemplate">
            <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded}" Foreground="#CBD5E1" Background="Transparent" BorderThickness="0" Width="190" Margin="0,2">
                <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource StepButtonStyle}" Content="{Binding Label}" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding ToolTip}" HorizontalContentAlignment="Left" Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="ProjectFileTemplate">
            <Button Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,2">
                <StackPanel>
                    <controls:SelectableTextBlock Text="{Binding Path=Name, Mode=OneWay}" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                    <controls:SelectableTextBlock Text="{Binding Path=Path, Mode=OneWay}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ScriptItemTemplate">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding DataContext.SelectScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" PreviewMouseRightButtonDown="ScriptRightClick" HorizontalContentAlignment="Stretch" Padding="9,8" Margin="0,0,2,0">
                    <StackPanel>
                        <controls:SelectableTextBlock Text="{Binding Path=Name, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <controls:SelectableTextBlock Text="{Binding Path=Description, Mode=OneWay}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                <Button Grid.Column="1" Content="⚙" Command="{Binding DataContext.OpenScriptPropertiesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="查看脚本属性" Padding="0"/>
                <Button Grid.Column="2" Content="×" Command="{Binding DataContext.DeleteScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="删除脚本" Padding="0"/>
                </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="8,3,8,7">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ 运行" Command="{Binding RuntimeLaunchCommand}" Background="#0F766E" BorderBrush="#14B8A6" ToolTip="关闭编辑器并启动轻量纯运行悬浮窗"/>
                        <Button Content="▶ 调试运行" Command="{Binding RunCommand}" Background="#2563EB" BorderBrush="#3B82F6" ToolTip="在编辑器中运行并显示调试状态"/>
                        <Button Content="Ⅱ 暂停" Command="{Binding PauseCommand}"/>
                        <Button Content="继续" Command="{Binding ResumeCommand}"/>
                        <Button Content="■ 停止" Command="{Binding StopCommand}"/>
                        <Border Width="1" Height="20" Margin="8,0" Background="#334155"/>
                        <Button Content="项目" Command="{Binding ToggleProjectFilesPaneCommand}" ToolTip="显示或隐藏项目文件"/>
                        <Button Content="脚本" Command="{Binding ToggleScriptListPaneCommand}" ToolTip="显示或隐藏脚本列表"/>
                        <Button Content="原子动作 / Actions" Command="{Binding ToggleToolboxPaneCommand}" ToolTip="显示或隐藏原子动作 / Actions"/>
                        <Button Content="属性" Command="{Binding TogglePropertiesPaneCommand}" ToolTip="显示或隐藏属性面板"/>
                        <Button Content="日志" Command="{Binding ToggleOutputPaneCommand}" ToolTip="显示或隐藏运行日志"/>
                        <Border Width="1" Height="20" Margin="8,0" Background="#334155"/>
                        <Button Content="设置" Command="{Binding SettingsCommand}" ToolTip="打开全局设置"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SelectableTextBlock Text="{Binding Path=ProjectName, Mode=OneWay}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="12" Padding="12,4">
                            <controls:SelectableTextBlock Text="{Binding Path=StateText, Mode=OneWay}" Foreground="#93C5FD"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="{Binding OutputPaneHeight, Mode=TwoWay}" MinHeight="{Binding OutputPaneMinHeight}"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ProjectFilesPaneWidth, Mode=TwoWay}" MinWidth="{Binding ProjectFilesPaneMinWidth}"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="{Binding ScriptListPaneWidth, Mode=TwoWay}" MinWidth="{Binding ScriptListPaneMinWidth}"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="{Binding PropertiesPaneWidth, Mode=TwoWay}" MinWidth="{Binding PropertiesPaneMinWidth}"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0" Visibility="{Binding IsProjectFilesPaneVisible, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="38" Background="#141D2E" Margin="0,0,0,6">
                        <controls:SelectableTextBlock Text="项目文件" FontWeight="SemiBold" FontSize="13" Margin="12,0" VerticalAlignment="Center"/>
                        <Button Content="—" Style="{StaticResource PaneHeaderButton}" HorizontalAlignment="Right" Command="{Binding ToggleProjectFilesPaneCommand}" ToolTip="最小化项目文件"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                        <StackPanel>
                            <controls:SelectableTextBlock Text="当前文件" Foreground="#64748B" FontSize="11" Margin="3,2,3,4"/>
                            <Border Background="#1D2A42" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="5" Padding="9,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <controls:SelectableTextBlock Text="{Binding Path=CurrentFileName, Mode=OneWay}" Foreground="#F8FAFC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <controls:SelectableTextBlock Text="{Binding Path=CurrentPathText, Mode=OneWay}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <controls:SelectableTextBlock Text="文件操作" Foreground="#64748B" FontSize="11" Margin="3,0,3,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="新建" Command="{Binding NewCommand}" Width="84" Padding="5,5"/>
                                <Button Content="打开" Command="{Binding OpenCommand}" Width="84" Padding="5,5"/>
                                <Button Content="保存" Command="{Binding SaveCommand}" Width="84" Padding="5,5"/>
                                <Button Content="另存为" Command="{Binding SaveAsCommand}" Width="84" Padding="5,5"/>
                            </WrapPanel>
                            <controls:SelectableTextBlock Text="最近项目" Foreground="#64748B" FontSize="11" Margin="3,0,3,4"/>
                            <ItemsControl ItemsSource="{Binding RecentProjectFiles}" ItemTemplate="{StaticResource ProjectFileTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource VerticalGridSplitter}" Visibility="{Binding IsProjectFilesPaneVisible, Converter={StaticResource BoolVisibility}}"/>

            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0" Visibility="{Binding IsScriptListPaneVisible, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="38" Background="#141D2E" Margin="0,0,0,6">
                        <controls:SelectableTextBlock Text="脚本列表" FontWeight="SemiBold" FontSize="13" Margin="12,0" VerticalAlignment="Center"/>
                        <Button Content="—" Style="{StaticResource PaneHeaderButton}" HorizontalAlignment="Right" Command="{Binding ToggleScriptListPaneCommand}" ToolTip="最小化脚本列表"/>
                        <Button Content="+" Style="{StaticResource PaneHeaderButton}" HorizontalAlignment="Right" Margin="4,5,38,5" Command="{Binding NewScriptCommand}" ToolTip="新建脚本"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                        <StackPanel>
                            <controls:SelectableTextBlock Text="当前项目脚本" Foreground="#64748B" FontSize="11" Margin="3,2,3,4"/>
                            <ItemsControl ItemsSource="{Binding Scripts}" ItemTemplate="{StaticResource ScriptItemTemplate}"/>
                            <controls:SelectableTextBlock Text="一个项目可以包含多个脚本，可在此切换当前脚本" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="3,12,3,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" Style="{StaticResource VerticalGridSplitter}" Visibility="{Binding IsScriptListPaneVisible, Converter={StaticResource BoolVisibility}}"/>

            <Grid Grid.Row="0" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="{Binding StepsPaneHeight, Mode=TwoWay}" MinHeight="{Binding StepsPaneMinHeight}"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#09101E">
                    <wv2:WebView2 x:Name="EditorWebView" DefaultBackgroundColor="#09101E"/>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalGridSplitter}" Visibility="{Binding IsToolboxPaneVisible, Converter={StaticResource BoolVisibility}}"/>

                <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding IsToolboxPaneVisible, Converter={StaticResource BoolVisibility}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="38" Background="#141D2E" Margin="0,0,0,6">
                            <controls:SelectableTextBlock Text="原子动作 / Actions" FontWeight="SemiBold" FontSize="13" Margin="12,0" VerticalAlignment="Center"/>
                            <Button Content="—" Style="{StaticResource PaneHeaderButton}" HorizontalAlignment="Right" Command="{Binding ToggleToolboxPaneCommand}" ToolTip="最小化原子动作 / Actions"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8" Visibility="{Binding IsHorizontalStepLayout, Converter={StaticResource InverseBoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding ToolboxGroups}" ItemTemplate="{StaticResource StepCategoryTemplate}"/>
                        </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8,0,8,8" Visibility="{Binding IsHorizontalStepLayout, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding ToolboxGroups}" ItemTemplate="{StaticResource StepCategoryTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="0" Grid.Column="5" Grid.RowSpan="3" Style="{StaticResource VerticalGridSplitter}" Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BoolVisibility}}"/>

            <Border Grid.Row="0" Grid.Column="6" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="38" Background="#141D2E" Margin="0,0,0,6">
                        <controls:SelectableTextBlock Text="属性" FontWeight="SemiBold" FontSize="13" Margin="12,0" VerticalAlignment="Center"/>
                        <Button Content="—" Style="{StaticResource PaneHeaderButton}" HorizontalAlignment="Right" Command="{Binding TogglePropertiesPaneCommand}" ToolTip="最小化属性面板"/>
                    </Grid>
                    <controls:SelectableTextBlock Text="在画布中选择一个节点，或右键脚本查看脚本属性" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" Visibility="{Binding HasPropertySelection, Converter={StaticResource InverseBoolVisibility}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8" IsEnabled="{Binding IsProjectEditingEnabled}" Visibility="{Binding IsScriptPropertiesVisible, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <controls:SelectableTextBlock Text="当前脚本属性" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="3,4,3,14"/>
                            <controls:SelectableTextBlock Text="脚本 ID" Foreground="#94A3B8"/>
                            <controls:SelectableTextBlock Text="{Binding Path=ActiveScriptId, Mode=OneWay}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <controls:SelectableTextBlock Text="脚本名称" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding ActiveScriptName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" ToolTip="脚本名称在项目内必须唯一"/>
                            <controls:SelectableTextBlock Text="窗口范围" Foreground="#94A3B8"/>
                            <StackPanel Orientation="Horizontal" Margin="4,8,4,4">
                                <RadioButton GroupName="WindowScopeMode" Content="整个屏幕" IsChecked="{Binding UseWholeScreen, Mode=TwoWay}" Foreground="#E2E8F0" Margin="0,0,18,0"/>
                                <RadioButton GroupName="WindowScopeMode" Content="正则匹配窗口" IsChecked="{Binding ScriptWindowScopeEnabled, Mode=TwoWay}" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <controls:SelectableTextBlock Text="窗口标题正则（正则匹配窗口）" Foreground="#94A3B8" Margin="0,6,0,3"/>
                            <TextBox Text="{Binding ScriptWindowTitlePattern, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ScriptWindowScopeEnabled}"/>
                            <controls:SelectableTextBlock Text="选择“整个屏幕”时不限定窗口；选择“正则匹配窗口”时按标题正则查找并激活目标窗口。" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="3,5,3,0"/>
                            <controls:SelectableTextBlock Text="多窗口执行方式" Foreground="#94A3B8" Margin="0,10,0,3"/>
                            <ComboBox ItemsSource="{Binding WindowExecutionModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ScriptWindowExecutionMode, Mode=TwoWay}" IsEnabled="{Binding ScriptWindowScopeEnabled}"/>
                            <controls:SelectableTextBlock Text="{Binding ScriptWindowExecutionModeDescription, Mode=OneWay}" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="3,5,3,0"/>
                            <controls:SelectableTextBlock Text="节点默认等待时间（毫秒）" Foreground="#94A3B8" Margin="0,16,0,3"/>
                            <TextBox Text="{Binding ScriptDefaultNodeDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                            <controls:SelectableTextBlock Text="设置为 0 表示关闭；显式等待节点仍使用自身等待时间。以上配置只对当前脚本生效。" Foreground="#64748B" TextWrapping="Wrap" Margin="3,6,3,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8" IsEnabled="{Binding IsProjectEditingEnabled}" Visibility="{Binding HasDetectorConditionSelection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel DataContext="{Binding SelectedNode}">
                            <controls:SelectableTextBlock Text="{Binding Path=LogicLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FBBF24" Margin="3,4,3,2"/>
                            <controls:SelectableTextBlock Text="动作 ID" Foreground="#94A3B8"/>
                            <controls:SelectableTextBlock Text="{Binding Path=Id, Mode=OneWay}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <controls:SelectableTextBlock Text="直接配置本节点的检测内容，命中后从 true 分支继续，否则从 false 分支继续。" Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="3,0,3,10"/>
                            <StackPanel Visibility="{Binding HasCoordinateParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="坐标基准" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <ItemsControl ItemsSource="{Binding CoordinateParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Tag="followScript" Content="跟随脚本"/>
                                                <ComboBoxItem Tag="absolute" Content="强制绝对"/>
                                                <ComboBoxItem Tag="relative" Content="强制相对"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasConfidenceParameter, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,2">
                                <DockPanel Margin="0,0,0,3">
                                    <controls:SelectableTextBlock Text="{Binding ConfidenceLabel, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding ConfidenceHint, Mode=OneWay}"/>
                                    <controls:SelectableTextBlock DockPanel.Dock="Right" Text="{Binding ConfidenceParameter.Value, Mode=OneWay, Converter={StaticResource PercentText}}" Foreground="#60A5FA" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                        Value="{Binding ConfidenceParameter.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringPercent}}"
                                        ToolTip="{Binding ConfidenceHint, Mode=OneWay}"/>
                                <controls:SelectableTextBlock Text="拖动滑块降低阈值可增强抗噪能力，但可能增加误判。" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="3,2,3,0"/>
                            </StackPanel>
                            <controls:SelectableTextBlock Text="数值参数" Foreground="#94A3B8" Margin="0,0,0,3"/>
                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.SelectedNode.CoordinatePickButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.PickCoordinateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding DataContext.SelectedNode.CanPickCoordinate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"
                                            Width="82" Margin="8,0,0,0" Padding="4,3" ToolTip="{Binding DataContext.SelectedNode.CoordinatePickButtonToolTip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <ItemsControl ItemsSource="{Binding NumericParameters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="112" Margin="0,2,6,2">
                                                    <controls:SelectableTextBlock Text="{Binding Name, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding Description}"/>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                            <controls:SelectableTextBlock Text="文本参数" Foreground="#94A3B8" Margin="0,8,0,3"/>
                            <ItemsControl ItemsSource="{Binding TextParameters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="280" Margin="0,3">
                                            <controls:SelectableTextBlock Text="{Binding Path=DisplayName, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding Description}"/>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:SelectableTextBlock Text="命中输出 true，未命中输出 false。" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="3,6,3,12"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8" IsEnabled="{Binding IsProjectEditingEnabled}" Visibility="{Binding IsRegularNodeSelection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel DataContext="{Binding SelectedNode}">
                            <controls:SelectableTextBlock Text="动作 ID" Foreground="#94A3B8"/>
                            <controls:SelectableTextBlock Text="{Binding Path=Id, Mode=OneWay}" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <controls:SelectableTextBlock Text="节点名称" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            <controls:SelectableTextBlock Text="参数配置" Foreground="#94A3B8" Margin="0,12,0,4"/>
                            <StackPanel Visibility="{Binding HasCoordinateParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="坐标基准" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <ItemsControl ItemsSource="{Binding CoordinateParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Tag="followScript" Content="跟随脚本"/>
                                                <ComboBoxItem Tag="absolute" Content="强制绝对"/>
                                                <ComboBoxItem Tag="relative" Content="强制相对"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasNumericParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="数值参数" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding DataContext.SelectedNode.CoordinatePickButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.PickCoordinateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding DataContext.SelectedNode.CanPickCoordinate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"
                                                Width="82" Margin="8,0,0,0" Padding="4,3" ToolTip="{Binding DataContext.SelectedNode.CoordinatePickButtonToolTip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <ItemsControl ItemsSource="{Binding NumericParameters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="112" Margin="0,2,6,2">
                                                        <controls:SelectableTextBlock Text="{Binding Name, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding Description}"/>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasTextParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="文本参数" Foreground="#94A3B8" Margin="0,8,0,3"/>
                                <ItemsControl ItemsSource="{Binding TextParameters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,6,3">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Width" Value="136"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Name}" Value="path"/>
                                                                    <Condition Binding="{Binding DataContext.SelectedNode.CanPickProgramPath, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Width" Value="280"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <controls:SelectableTextBlock Text="{Binding Path=DisplayName, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding Description}"/>
                                                <DockPanel Grid.Row="1">
                                                    <Button DockPanel.Dock="Right" Content="选择..."
                                                            Command="{Binding DataContext.SelectProgramPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Width="58" Margin="6,0,0,0" Padding="4,2" ToolTip="选择要启动的程序文件">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Name}" Value="path"/>
                                                                            <Condition Binding="{Binding DataContext.SelectedNode.CanPickProgramPath, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DockPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasChoiceParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="枚举参数" Foreground="#94A3B8" Margin="0,8,0,3"/>
                                <ItemsControl ItemsSource="{Binding ChoiceParameters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="136" Margin="0,3,6,3">
                                                <controls:SelectableTextBlock Text="{Binding Path=DisplayName, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding Description}"/>
                                                <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="button"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Name}" Value="level"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                    <ComboBoxItem Tag="left" Content="left · 左键">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="button"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="right" Content="right · 右键">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="button"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="middle" Content="middle · 中键">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="button"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="debug" Content="debug · 调试">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="level"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="information" Content="information · 信息">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="level"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="warning" Content="warning · 警告">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="level"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="error" Content="error · 错误">
                                                        <ComboBoxItem.Style>
                                                            <Style TargetType="ComboBoxItem">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=DataContext.Name}" Value="level"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBoxItem.Style>
                                                    </ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasBooleanParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="开关参数" Foreground="#94A3B8" Margin="0,8,0,3"/>
                                <ItemsControl ItemsSource="{Binding BooleanParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#E2E8F0" Margin="0,3" ToolTip="{Binding Description}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasOtherParameters, Converter={StaticResource BoolVisibility}}">
                                <controls:SelectableTextBlock Text="其他参数" Foreground="#94A3B8" Margin="0,8,0,3"/>
                                <ItemsControl ItemsSource="{Binding OtherParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <controls:SelectableTextBlock Text="{Binding Path=DisplayName, Mode=OneWay}" Foreground="#94A3B8" ToolTip="{Binding Description}"/>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource HorizontalGridSplitter}" Visibility="{Binding IsOutputPaneVisible, Converter={StaticResource BoolVisibility}}"/>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Background="#0F172A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding IsOutputPaneVisible, Converter={StaticResource BoolVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="10,0">
                        <controls:SelectableTextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="—" Style="{StaticResource PaneHeaderButton}" DockPanel.Dock="Right" Command="{Binding ToggleOutputPaneCommand}" ToolTip="最小化运行日志"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <controls:SelectableTextBlock Text="当前节点：" Foreground="#64748B"/>
                            <controls:SelectableTextBlock Text="{Binding Path=CurrentNodeText, Mode=OneWay}" Margin="0,0,18,0"/>
                            <controls:SelectableTextBlock Text="耗时：" Foreground="#64748B"/>
                            <controls:SelectableTextBlock Text="{Binding Path=ElapsedText, Mode=OneWay}"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="#090F1B" Foreground="#CBD5E1" BorderThickness="0" Padding="10,4" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:SelectableTextBlock Text="{Binding Path=DisplayText, Mode=OneWay}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
