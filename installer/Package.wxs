<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="GameFlow Studio"
    Manufacturer="GameFlow Studio"
    Version="$(AppVersion)"
    Language="2052"
    Scope="perMachine"
    UpgradeCode="E4F858AD-16A8-4BA9-8CE2-DC9368280262">

    <Property Id="CREATE_START_MENU_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 GameFlow Studio。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <Icon Id="GameFlowStudioIcon" SourceFile="$(sys.SOURCEFILEDIR)GameFlowStudio.ico" />

    <StandardDirectory Id="TARGETDIR">
      <Directory
        Id="INSTALLFOLDER"
        Name="GameFlow Studio"
        ComponentGuidGenerationSeed="D2BD7E73-1F51-4B69-B9C7-A76F3E62B06F">
        <Component Id="MainExecutable" Guid="*">
          <File
            Id="GameFlowStudioExecutable"
            Source="$(PublishDir)\GameFlowStudio.Desktop.exe"
            KeyPath="yes" />
        </Component>

        <Component
          Id="StartMenuShortcut"
          Guid="B7A98D9E-C1F6-4A6A-8CC4-4D1C0DCB5D9A"
          Condition="CREATE_START_MENU_SHORTCUT">
          <Shortcut
            Id="StartMenuShortcutFile"
            Directory="ProgramMenuFolder"
            Name="GameFlow Studio"
            Description="Windows 无代码键盘鼠标自动化工具"
            Target="[INSTALLFOLDER]GameFlowStudio.Desktop.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="GameFlowStudioIcon"
            IconIndex="0" />
          <RegistryValue
            Root="HKCU"
            Key="Software\GameFlow Studio"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>

        <Component
          Id="DesktopShortcut"
          Guid="D3AAE8E8-9FE1-4D06-9D65-2E4C4B2D85DD"
          Condition="CREATE_DESKTOP_SHORTCUT">
          <Shortcut
            Id="DesktopShortcutFile"
            Directory="DesktopFolder"
            Name="GameFlow Studio"
            Description="Windows automation workflow tool"
            Target="[INSTALLFOLDER]GameFlowStudio.Desktop.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="GameFlowStudioIcon"
            IconIndex="0" />
          <RegistryValue
            Root="HKCU"
            Key="Software\GameFlow Studio"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>

        <Files Include="$(PublishDir)\**">
          <Exclude Files="$(PublishDir)\GameFlowStudio.Desktop.exe" />
        </Files>
      </Directory>
    </StandardDirectory>

    <UI>
      <Dialog Id="ShortcutOptionsDlg" Width="370" Height="270" Title="GameFlow Studio">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" NoPrefix="yes" Text="安装选项" />
        <Control Id="Description" Type="Text" X="20" Y="40" Width="330" Height="30" NoPrefix="yes" Text="请选择是否创建开始菜单快捷方式。" />
        <Control
          Id="CreateDesktopShortcut"
          Type="CheckBox"
          X="20"
          Y="90"
          Width="330"
          Height="17"
          Property="CREATE_DESKTOP_SHORTCUT"
          CheckBoxValue="1"
          Text="Create a desktop shortcut" />
        <Control
          Id="CreateStartMenuShortcut"
          Type="CheckBox"
          X="20"
          Y="120"
          Width="330"
          Height="17"
          Property="CREATE_START_MENU_SHORTCUT"
          CheckBoxValue="1"
          Text="创建开始菜单快捷方式" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="返回">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutOptionsDlg" Order="3" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
    </UI>
  </Package>
</Wix>
